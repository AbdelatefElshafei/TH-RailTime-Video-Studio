{
  "name": "th-realtime-video-studio",
  "version": "1.0.0",
  "description": "A powerful, open-source, browser-based video editor designed for performance and extensibility. Features real-time previews, proxy workflow, and a plugin API.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "server": "node server/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ffmpeg": "jest --testPathPattern=ffmpeg",
    "test:plugins": "jest --testPathPattern=plugins",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "echo \"No build process needed for this project\"",
    "clean": "node -e \"const fs=require('fs');['uploads','proxies','processed','previews','thumbnails','waveforms'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true});console.log('Cleaned',d)}catch(e){}})\"",
    "setup": "npm install && node -e \"const fs=require('fs');['uploads','proxies','processed','previews','thumbnails','waveforms','luts'].forEach(d=>{try{fs.mkdirSync(d,{recursive:true});console.log('Created',d)}catch(e){}})\""
  },
  "keywords": [
    "video-editor",
    "browser-based",
    "ffmpeg",
    "real-time",
    "non-linear-editing",
    "proxy-workflow",
    "plugin-api",
    "color-correction",
    "keyframe-animation",
    "chroma-key",
    "masking",
    "open-source"
  ],
  "author": "AbdelatefElshafei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AbdelatefElshafei/TH-RailTime-Video-Studio.git"
  },
  "bugs": {
    "url": "https://github.com/AbdelatefElshafei/TH-RailTime-Video-Studio/issues"
  },
  "homepage": "https://github.com/AbdelatefElshafei/TH-RailTime-Video-Studio#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "cuid": "^3.0.0",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^2.0.2",
    "sanitize-filename": "^1.6.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4"
  },
  "files": [
    "server.js",
    "public/",
    "plugins/",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "TODO.md"
  ]
}
